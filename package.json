{
	"name": "reltio-design-platform",
	"version": "0.0.0",
	"private": true,
	"description": "Reltio Design Platform monorepo — development workspace for the @reltio/* packages. Not published.",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"keywords": [
		"Reltio",
		"design",
		"ui",
		"kit",
		"library",
		"tools",
		"system"
	],
	"homepage": "https://bitbucket.org/reltio-ondemand/reltio-design#readme",
	"bugs": {
		"url": "https://bitbucket.org/reltio-ondemand/reltio-design/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@bitbucket.org/reltio-ondemand/reltio-design.git"
	},
	"license": "Apache-2.0",
	"author": "",
	"scripts": {
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dev": "storybook dev -p 6006",
		"predev": "npm run build-component-docs",
		"build-storybook": "storybook build",
		"prebuild-storybook": "npm run build-component-docs",
		"build-css": "node scripts/build-css.mjs",
		"build-tokens": "node scripts/build-tokens.mjs",
		"build-api-docs": "node scripts/build-api-docs.mjs",
		"prebuild-component-docs": "npm run build-css",
		"build-component-docs": "node scripts/build-component-docs.mjs",
		"deploy": "chromatic --exit-zero-on-changes --exit-once-uploaded",
		"lint": "biome check .",
		"format": "biome format . --write",
		"changeset": "changeset",
		"changeset:status": "changeset status --since=origin/main",
		"version-packages": "changeset version",
		"release": "node scripts/release.mjs",
		"release:snapshot": "node scripts/release.mjs --snapshot"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@changesets/cli": "^2.27.10",
		"@chromatic-com/storybook": "^5.1.2",
		"@faker-js/faker": "^10.3.0",
		"@fission-ai/openspec": "^1.2.0",
		"@sap-theming/theming-base-content": "^11.35.1",
		"@storybook/addon-a11y": "^10.3.6",
		"@storybook/addon-docs": "^10.3.6",
		"@storybook/addon-mcp": "^0.4.2",
		"@storybook/addon-vitest": "^10.3.6",
		"@storybook/react-vite": "^10.3.6",
		"@types/d3-scale": "^4.0.9",
		"@types/dagre": "^0.7.54",
		"@types/node": "^22.0.0",
		"@types/react-dom": "^18.3.7",
		"@vitest/browser-playwright": "^4.0.14",
		"@vitest/coverage-v8": "^4.0.14",
		"chromatic": "^13.3.4",
		"msw": "^2.12.14",
		"msw-storybook-addon": "^2.0.6",
		"playwright": "^1.57.0",
		"postcss": "^8.5.6",
		"postcss-modules": "^6.0.1",
		"prop-types": "^15.8.1",
		"storybook": "^10.3.6",
		"vitest": "^4.0.14"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@storybook/mcp": "^0.6.1",
		"@ui5/webcomponents-fiori": "^2.21.1",
		"@ui5/webcomponents-icons": "^2.21.1",
		"@ui5/webcomponents-react": "^2.21.3",
		"@xyflow/react": "^12.10.2",
		"d3-scale": "^4.0.2",
		"echarts": "^6.0.0",
		"markdown-to-jsx": "^9.7.3",
		"rc-tree": "^5.13.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"style-inject": "^0.3.0"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
