{
	"name": "@reltio/design",
	"version": "1.0.0",
	"description": "Reltio design system and tools",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./icons": "./icons/index.ts",
		"./icons/*": "./icons/*.tsx"
	},
	"keywords": [
		"Reltio",
		"design",
		"ui",
		"kit",
		"library",
		"tools",
		"system"
	],
	"homepage": "https://bitbucket.org/reltio-ondemand/reltio-design#readme",
	"bugs": {
		"url": "https://bitbucket.org/reltio-ondemand/reltio-design/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@bitbucket.org/reltio-ondemand/reltio-design.git"
	},
	"license": "ISC",
	"author": "",
	"main": "index.js",
	"scripts": {
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dev": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build-css": "node scripts/build-css.mjs",
		"build-tokens": "node scripts/build-tokens.mjs",
		"deploy": "chromatic --exit-zero-on-changes --exit-once-uploaded",
		"lint": "biome check .",
		"format": "biome format . --write",
		"generate-icons": "node scripts/generate-icons.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@chromatic-com/storybook": "^5.0.1",
		"@fission-ai/openspec": "^1.1.1",
		"@storybook/addon-a11y": "^10.2.8",
		"@storybook/addon-docs": "^10.2.8",
		"@storybook/addon-themes": "^10.2.8",
		"@storybook/addon-vitest": "^10.2.8",
		"@storybook/nextjs-vite": "^10.2.8",
		"@types/node": "^22.0.0",
		"@vitest/browser-playwright": "^4.0.14",
		"@vitest/coverage-v8": "^4.0.14",
		"chromatic": "^13.3.4",
		"playwright": "^1.57.0",
		"postcss": "^8.5.6",
		"postcss-modules": "^6.0.1",
		"prop-types": "^15.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"storybook": "^10.2.8",
		"vitest": "^4.0.14"
	},
	"dependencies": {
		"markdown-to-jsx": "^9.7.3",
		"rc-tree": "^5.13.1"
