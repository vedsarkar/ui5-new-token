# Copy this file to .env.local and fill in your Reltio OAuth client secrets.
# .env.local is gitignored — never commit real credentials.
#
# The environment holds secrets and the build-time BASE_PATH. Runtime,
# non-secret settings (oauthPath, loginPath, ...) live in config/*.json and are
# resolved at startup by APP_CONFIG.

# Which config to resolve at startup: "dev" or "prod". Selects
# config/<APP_CONFIG>.json, deep-merged over config/default.json. Injected at
# deploy/start time — build artifacts are identical across environments.
APP_CONFIG='dev'

# The sub-path this app is served under, e.g. /my-app. Build-time setting baked
# into the artifact by Next (routing, links, assets), so it lives here, not in
# config/*.json. Must start with "/" and not end with "/".
BASE_PATH='/my-app'

# OAuth client registered with Reltio (secrets — kept out of config/*.json).
# These credentials are for the Reltio auth service.
#
# NOTE: Next's env loader expands `$NAME` and treats `#` as an inline comment.
# If a secret contains `$` or `#`, wrap it in single quotes AND escape each `$`
# as `\$`, e.g. API_CLIENT_SECRET='a$b#c' → API_CLIENT_SECRET='a\$b#c'.
AUTH_CLIENT_ID=''
AUTH_CLIENT_SECRET=''

# Separate OAuth client used to call the Reltio API services.
API_CLIENT_ID=''
API_CLIENT_SECRET=''

# Set to false for local http development so session cookies are not Secure-only.
# Leave unset (or use any other value) in production to keep cookies Secure.
SECURE='false'
