{
	"name": "@reltio/app",
	"version": "0.4.0",
	"description": "Reltio application CLI — scaffold and maintain a Next.js App Router app wired to @reltio/design and @reltio/auth.",
	"license": "Apache-2.0",
	"homepage": "https://reltio.design",
	"bugs": {
		"url": "https://bitbucket.org/reltio-ondemand/reltio-design/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@bitbucket.org/reltio-ondemand/reltio-design.git",
		"directory": "packages/app"
	},
	"keywords": [
		"reltio",
		"cli",
		"create",
		"scaffold",
		"nextjs",
		"template",
		"starter"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"app": "./bin/cli.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"postbuild": "cp README.md dist/ && cp ../../LICENSE dist/ && cp ../../NOTICE dist/"
	}
}
