	"description": "Reltio agent skills — installable AI-agent skills (Cursor, Claude, Codex) for adopting the Reltio Design Platform.",
	"license": "Apache-2.0",
	"homepage": "https://reltio.design",
	"bugs": {
		"url": "https://bitbucket.org/reltio-ondemand/reltio-design/issues"
	},
	"repository": {
