{
	"include": ["*.ts", "../../icons/**/*.ts", "../../icons/**/*.tsx"],
	"exclude": [
		"../../icons/icons.stories.tsx",
		"../../icons/ReltioIconGallery.tsx"
	],
	"compilerOptions": {
		"baseUrl": "../../",
		"outDir": "./dist",
		"target": "ES2020",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"declaration": true,
		"paths": {
			"@/*": ["./*"],
			"@reltio/design/components": ["components/index.ts"]
		}
	}
}
