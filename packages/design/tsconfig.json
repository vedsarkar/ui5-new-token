{
	"compilerOptions": {
		"baseUrl": "../../",
		"outDir": "./dist",
		"target": "ES2020",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "node",
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"declaration": true,
		"paths": {
			"@/*": ["./*"]
		}
	}
}
