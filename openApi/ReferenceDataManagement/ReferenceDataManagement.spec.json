{
	"openapi": "3.1.0",
	"info": {
		"title": "Reference Data Management API",
		"version": "1.0.0",
		"description": "Manage Reference Data Management (RDM) tenant configuration and canonical code generators. Generators automatically produce unique codes (UUID or sequential) for canonical values in lookup types."
	},
	"servers": [
		{
			"url": "https://{environment}.reltio.com",
			"variables": {
				"environment": {
					"default": "{environment}",
					"description": "Reltio environment name (e.g. dev, qa, prod)"
				}
			}
		}
	],
	"paths": {
		"/configuration/{tenantId}": {
			"get": {
				"operationId": "getByTenant",
				"summary": "GET /configuration/{tenantId}",
				"description": "Retrieves the configuration details of the RDM tenant.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "RDM tenant configuration.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"403": {
						"description": "Forbidden — insufficient permissions."
					},
					"404": {
						"description": "Tenant not found."
					}
				}
			},
			"put": {
				"operationId": "updateByTenant",
				"summary": "PUT /configuration/{tenantId}",
				"description": "Updates or sets the RDM tenant configuration. If a configuration already exists, it is overridden.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"description": "RDM configuration object.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Configuration saved successfully.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"403": {
						"description": "Forbidden — insufficient permissions."
					},
					"404": {
						"description": "Tenant not found."
					}
				}
			}
		},
		"/generators/{tenantId}": {
			"post": {
				"operationId": "rdmCreateGenerator",
				"summary": "POST /generators/{tenantId}",
				"description": "Creates a generator that automatically produces canonical codes for all canonical values in a lookup type. Supports UUID and Sequential generator types.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"description": "Generator definition.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/Generator"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Generator created successfully.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Generator"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"403": {
						"description": "Forbidden — insufficient permissions."
					}
				}
			}
		},
		"/generators/{tenantId}/{name}": {
			"get": {
				"operationId": "rdmGetGeneratorByTenant",
				"summary": "GET /generators/{tenantId}/{name}",
				"description": "Gets a generator for a tenant by its name. Returns details such as name, type, start value, and current value.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "name",
						"in": "path",
						"description": "Name of the generator.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Generator details.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Generator"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Generator not found."
					}
				}
			},
			"delete": {
				"operationId": "rdmDeleteGeneratorByTenant",
				"summary": "DELETE /generators/{tenantId}/{name}",
				"description": "Deletes a generator. If the generator is used by any lookup type, it cannot be deleted — remove dependencies first.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "name",
						"in": "path",
						"description": "Name of the generator to delete.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Generator deleted successfully."
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Generator not found."
					},
					"409": {
						"description": "Conflict — generator is in use by a lookup type."
					}
				}
			}
		},
		"/generators/{tenantId}/{name}/generate": {
			"get": {
				"operationId": "rdmGenerateNextValue",
				"summary": "GET /generators/{tenantId}/{name}/generate",
				"description": "Generates and returns the next value for the specified generator. For sequential generators, increments the current value by one.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "name",
						"in": "path",
						"description": "Name of the generator.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Generated value.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"value": {
											"type": "string",
											"description": "The generated value."
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Generator not found."
					}
				}
			}
		},
		"/lookups/{tenantId}": {
			"post": {
				"operationId": "rdmSaveLookups",
				"summary": "POST /lookups/{tenantId}",
				"description": "Saves lookups in the RDM tenant. Accepts an array of lookup objects spanning one or more lookup types.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/Lookup"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Lookups saved.",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Lookup"
									}
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					}
				}
			}
		},
		"/lookups/{tenantId}/{type}": {
			"post": {
				"operationId": "rdmSaveLookupsByType",
				"summary": "POST /lookups/{tenantId}/{type}",
				"description": "Saves lookups for the specified lookup type. Accepts an array of lookup objects scoped to the given type.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "type",
						"in": "path",
						"description": "Lookup type name.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/Lookup"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Lookups saved.",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Lookup"
									}
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Lookup type not found."
					}
				}
			}
		},
		"/lookups/{tenantId}/{type}/{code}": {
			"put": {
				"operationId": "rdmSaveLookupByTypeAndCode",
				"summary": "PUT /lookups/{tenantId}/{type}/{code}",
				"description": "Saves a single lookup for the specified lookup type and canonical code. Replaces the lookup if it already exists.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "type",
						"in": "path",
						"description": "Lookup type name.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "code",
						"in": "path",
						"description": "Canonical code of the lookup value.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/Lookup"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Lookup saved.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Lookup"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Lookup type not found."
					}
				}
			}
		},
		"/unmapped/{tenantId}": {
			"post": {
				"operationId": "rdmSaveUnmappedValues",
				"summary": "POST /unmapped/{tenantId}",
				"description": "Saves lookup values that are not mapped to a canonical value. Accepts an array of unmapped string values to be reviewed and later mapped to canonical lookups.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Unmapped values saved."
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					}
				}
			}
		},
		"/unmapped/{tenantId}/{type}": {
			"post": {
				"operationId": "rdmSaveUnmappedValuesByType",
				"summary": "POST /unmapped/{tenantId}/{type}",
				"description": "Saves lookup values that are not mapped to a canonical value for the specified lookup type. Accepts an array of unmapped string values scoped to the given type.",
				"parameters": [
					{
						"name": "tenantId",
						"in": "path",
						"description": "ID of the tenant.",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "type",
						"in": "path",
						"description": "Lookup type name.",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Unmapped values saved."
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token."
					},
					"404": {
						"description": "Lookup type not found."
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Generator": {
				"type": "object",
				"required": ["name", "type"],
				"description": "A canonical code generator that produces unique values for lookup types.",
				"properties": {
					"name": {
						"type": "string",
						"description": "Unique name of the generator."
					},
					"type": {
						"type": "string",
						"enum": ["UUID", "SEQUENTIAL"],
						"description": "Generator type — UUID produces universally unique identifiers, SEQUENTIAL produces incrementing numbers."
					},
					"startValue": {
						"type": "integer",
						"description": "Start value for sequential generators."
					},
					"currentValue": {
						"type": "integer",
						"readOnly": true,
						"description": "Current value of the sequential generator."
					},
					"description": {
						"type": "string",
						"description": "Human-readable description."
					}
				}
			},
			"Lookup": {
				"type": "object",
				"description": "A reference data lookup — a single canonical value within a lookup type.",
				"properties": {
					"code": {
						"type": "string",
						"description": "Canonical code that uniquely identifies the lookup within its type."
					},
					"value": {
						"type": "string",
						"description": "Human-readable value displayed to users."
					},
					"description": {
						"type": "string",
						"description": "Optional description of the lookup."
					},
					"source": {
						"type": "string",
						"description": "Source system that contributed this lookup value."
					},
					"parent": {
						"type": "string",
						"description": "Code of the parent lookup, when lookups form a hierarchy."
					}
				}
			}
		}
	}
}
