# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
build/
.next/
next-env.d.ts
*.tsbuildinfo
*.log
.env*
coverage/
storybook-static/
*.module.css.ts
*.module.css.json
.npmrc

# Log files
*.log

# JetBrains IDE
.idea/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Git worktrees
.worktrees/

# IDE
*.swp
*.tmp

# Git worktrees
.worktrees/

# Applications
*.app
*.exe
*.war
.vercel
.env*.local

# Auto-generated by `npm run build-api-docs` (run via predev / prebuild-storybook / pretest hooks)
api/*/*.story.mdx

# Application source code is no longer tracked here. Apps are linked into the
# IDE via VSCode multi-root workspaces; if a developer clones an app into
# `apps/<name>/src/` for local cross-app analysis, those files stay untracked.
apps/*/src/

# @reltio/app — local-run lockfile (its own .gitignore covers the rest)
app-template/package-lock.json

# @reltio/create-app — app-template/ is generated from the root app-template/
# at prepack, and the LICENSE/NOTICE copies are staged there at prepack too.
packages/create-app/app-template/
packages/create-app/LICENSE
packages/create-app/NOTICE
