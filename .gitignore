# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
build/
.next/
next-env.d.ts
*.tsbuildinfo
*.log
.env*
coverage/
storybook-static/
*.module.css.ts
*.module.css.json
.npmrc

# Log files
*.log

# JetBrains IDE
.idea/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Git worktrees
.worktrees/

# IDE
*.swp
*.tmp

# Git worktrees
.worktrees/

# Applications
*.app
*.exe
*.war
.vercel
.env*.local

# Auto-generated by `npm run build-api-docs` (run via predev / prebuild-storybook / pretest hooks)
api/*/*.story.mdx

# Application source code is no longer tracked here. Apps are linked into the
# IDE via VSCode multi-root workspaces; if a developer clones an app into
# `apps/<name>/src/` for local cross-app analysis, those files stay untracked.
apps/*/src/

# app-template — local-run lockfile (its own .gitignore covers the rest)
packages/app/app-template/package-lock.json

# ...but the example env file is a real template artifact and must be tracked
# (the broad `.env*` rule above would otherwise ignore it). `@reltio/app create`
# copies it into generated apps; the build renames it to `_env.local.example`.
!packages/app/app-template/.env.local.example

# @reltio/app — the CLI's dist/ (built by scripts/build.mjs, published from
# dist/) is already covered by the global `dist/` rule above, along with the
# app-template payload and LICENSE/NOTICE staged into it at build.

# Excluded from the public GitHub mirror (tracked on Bitbucket)
openspec/
apps/ontology-builder/*.docx
apps/ontology-builder/2026-*.md
