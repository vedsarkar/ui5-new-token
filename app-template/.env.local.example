# Copy this file to .env.local and fill in your Reltio OAuth client.
# .env.local is gitignored — never commit real credentials.

# The sub-path this app is served under, e.g. /my-app. Everything (routing,
# links, assets, the auth flow) is prefixed with it, so the app can be mounted
# behind a platform's path rewrite. Must start with "/" and not end with "/".
# Required — the app will not start without it. Visiting the origin root ("/")
# redirects here.
BASE_PATH=/my-app

# Reltio OAuth server (token endpoints), e.g. https://auth-stg.reltio.com/oauth
OAUTH_PATH=

# Reltio Login Page, e.g. https://login-stg.reltio.com
LOGIN_PATH=

# OAuth client registered with Reltio
CLIENT_ID=
CLIENT_SECRET=

# Set to false for local http development so session cookies are not Secure-only.
# Leave unset (or use any other value) in production to keep cookies Secure.
SECURE=false
